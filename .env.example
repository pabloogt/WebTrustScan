# Variables de entorno de WebTrustScan.
# Copia este fichero a `.env.local` y rellena los valores. `.env.local` está
# ignorado por Git. Aquí NO va ningún secreto real.
# Explicación de cada variable: docs/ENVIRONMENT_VARIABLES.md

# --- Aplicación -------------------------------------------------------------
# URL pública de la aplicación (sin barra final). Se usa en los enlaces de
# los correos. En local: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Interruptor de las cuentas. Solo el valor exacto "true" las activa.
# Déjalo vacío en producción hasta que se autorice su puesta en marcha.
ACCOUNTS_ENABLED=

# Clave para derivar identificadores de IP y correo (HMAC). Mínimo 32
# caracteres aleatorios. Genera una con:  openssl rand -hex 32
# Obligatoria en producción y en Preview.
IP_HASH_SECRET=

# --- Supabase (base de datos y autenticación) -------------------------------
# En local los tres valores los muestra `npx supabase status`.
# En la nube: Supabase Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Clave PÚBLICA (publishable / anon). Puede verse en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave SECRETA (secret / service_role). Se salta RLS: solo en el servidor.
# NUNCA le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Upstash Redis (límites de uso) -----------------------------------------
# Upstash Console > tu base de datos > REST API.
# En producción son obligatorias: sin ellas el analizador responde 503.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Solo si aceptas límites por instancia en producción (no recomendado).
# RATE_LIMIT_ALLOW_MEMORY=true

# --- Opcionales -------------------------------------------------------------
# Número de proxies de confianza delante de la aplicación, si NO es Vercel.
# TRUSTED_PROXY_HOPS=1
# Límites por minuto del analizador (por defecto 10 por cliente y 120 global).
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_GLOBAL_PER_MINUTE=120

# --- Correo (Resend) ---------------------------------------------------------
# No se configura aquí: el SMTP de Resend se introduce en Supabase
# (Authentication > Emails > SMTP Settings). Ver docs/SETUP_SUPABASE.md.

# --- Stripe (fase futura, NO configurar todavía) -----------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
